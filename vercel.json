{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/generate", "dest": "/api/generate.py" },
    { "src": "/api/enrich",   "dest": "/api/enrich.py"   },
    { "src": "/api/vote",     "dest": "/api/vote.py"     },
    { "src": "/(.*)",         "dest": "/$1"              }
  ]
}
